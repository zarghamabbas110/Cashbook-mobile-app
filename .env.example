# Copy to .env and fill in from Supabase → Project Settings → API.
#
# Both values are safe to commit into a build and ship to browsers: the anon
# key grants nothing by itself, because every table is protected by the
# row-level security policies in docs/supabase-schema.sql.
#
# The service_role key is NOT one of these. It bypasses all security and must
# never appear in this file, in the repo, or in the app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
